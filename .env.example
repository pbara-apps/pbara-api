# Required for the API
MONGO_DB_URI=
JWT_SECRET=

# Required for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Recommended: comma-separated frontend URLs
CORS_ORIGINS=

# Optional
PORT=
SALT_ROUND=
CLOUDINARY_UPLOAD_FOLDER=

# Optional, used by `npm run seed` to set the initial admin credentials
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=
# Sender; must use a domain verified in Resend, e.g. "PBA-RA <news@pbara.org.ng>"
MAIL_FROM=
# Optional: where replies go
MAIL_REPLY_TO=
API_PUBLIC_URL=
SITE_URL=
